#!/usr/bin/env bash
#
# Generate src/shared.liquid:
#   shared/*.liquid  — Liquid, emitted as-is (serialize payload data here)
#   shared/*.css     — concatenated into a single <style>
#   js/main.js       — entry point, bundled by esbuild (follows ES module
#                      imports) into a single IIFE <script>
#
# The bundle is wrapped in {% raw %} so Liquid never interprets it. Anything a
# script needs from the payload has to come through shared/*.liquid.
#

set -euo pipefail

cd "$(dirname "$0")/.."

esbuild=node_modules/.bin/esbuild
if [ ! -x "$esbuild" ]; then
  echo "esbuild not found — run \`npm install\`" >&2
  exit 1
fi

out=src/shared.liquid
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

shopt -s nullglob
stylesheets=(shared/*.css)

bundle="$("$esbuild" js/main.ts --bundle --format=iife --log-level=warning)"

{
  echo "{% comment %}GENERATED by bin/build-shared from shared/ and js/ — do not edit.{% endcomment %}"

  if [ ${#stylesheets[@]} -gt 0 ]; then
    echo "<style>"
    cat "${stylesheets[@]}"
    echo "</style>"
  fi

  for template in shared/*.liquid; do
    cat "$template"
  done

  echo "<script>"
  echo "{% raw %}"
  echo "$bundle"
  echo "{% endraw %}"
  echo "</script>"
} >"$tmp"

# only touch the output when it changes, so trmnlp doesn't reload needlessly
if cmp -s "$tmp" "$out"; then
  :
else
  mv "$tmp" "$out"
  echo "built $out"
fi
