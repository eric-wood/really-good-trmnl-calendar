{% raw %}
<template id="hourly-template">
  <div class="days"></div>
</template>

<template id="hourly-lines-template">
    <div class="lines"></div>
</template>

<template id="day-header-template-hourly">
  <div class="flex flex--between flex--left stretch-x">
    <span class="title">{{ dayOfWeek }}</span>
    <span class="title">{{ dateString }}</span>
  </div>
</template>

<template id="day-template-hourly">
  <div class="day">
    <div class="events"></div>
  </div>
</template>

<template id="day-template-list">
  <div class="flex flex--col gap stretch day">
    <div class="flex flex--between flex--left stretch-x">
      <span class="title">{{ dayOfWeek }}</span>
      <span class="title">{{ dateString }}</span>
    </div>
    <div class="divider"></div>
    <div class="events flex flex--col gap--small stretch"></div>
  </div>
</template>

<template id="event-template">
  <div class="item item--emphasis-{{ calendarIndex }}">
    <div class="meta"></div>
    <div class="content">
      <span class="title title--small">{{ name }}</span>
      <span class="description">{{ durationString }}</span>
    </div>
  </div>
</template>

<template id="hour-marker-template">
  <div class="hour-marker" style="top: {{ y }}px">
    <div class="divider"></div>
    <div class="label label--small bg--white">{{ hour }}</div>
  </div>
</template>

<template id="hourly-event">
  <div class="hourly-event bg--white">
    <div class="name label">{{ name }}</div>
    <div class="time label label--small">{{ durationString }}</div>
    <div class="stripe"></div>
  </div>
</template>

<template id="all-day-events-template">
  <div class="all-day"></div>
</template>

<template id="all-day-event-template">
  <div class="all-day-event">
    <div class="label label--small">{{ name }}</div>
  </div>
</template>
{% endraw %}

<style>
.layout.single-column .days {
  flex-direction: column;
  align-items: stretch;
}

/* stacked days should size to content, not split the height evenly */
.layout.single-column .day {
  flex: none;
}

.days {
  position: relative;
  display: grid;
  grid-template-columns: repeat({{ trmnl.plugin_settings.custom_fields_values.num_days }}, 1fr);
  grid-template-rows: auto auto 1fr;
  gap: 15px;
}

.days .divider--v {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -7.5px;
  grid-row: 1 / -1;
  z-index: 1;
}

.days .lines {
  position: absolute;
  width: 100%;
  height: 100%;
  grid-row: 3;
}

.all-day {
  display: grid;
  grid-template-columns: subgrid;
  grid-row: 2;
  grid-column: 1 / -1;
  z-index: 2;
}

.hour-marker {
  position: absolute;
  left: 0;
  right: 0;
}

.hour-marker .label {
  position: absolute;
  transform: translateY(-50%);
  text-align: right;
}

.events {
  position: relative;
  overflow: hidden;
  height: 100%;
}

.hourly-event {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding-left: 3px;
  border: solid var(--bg-black-color) 1px;
  z-index: 1;
}

.hourly-event.multi-line {
  flex-direction: column;
  justify-content: flex-start;
}

.hourly-event .stripe {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 5px;
}

.hourly-event .label {
  align-items: flex-start;
}
</style>

<div class="layout layout--col layout--stretch layout--left">
  <!--<div class="days flex flex--row flex--left flex--top gap--small"></div>-->
</div>

<!--
<div class="title_bar">
  <span class="title">Calendar</span>
</div>
-->

<script>
  window.renderEvents("full");
</script>
