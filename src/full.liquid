{% raw %}
<template id="day-template">
  <!--<div class="divider--v delete-first"></div>-->
  <div class="flex flex--col gap stretch">
    <div class="flex flex--between flex--left stretch-x">
      <span class="title">{{ dayOfWeek }}</span>
      <span class="title">{{ dateString }}</span>
    </div>
    <div class="divider"></div>
    <div class="events flex flex--col gap--small stretch-x"></div>
  </div>
</template>

<template id="event-template">
  <div class="item item--emphasis-{{ calendarIndex }}">
    <div class="meta"></div>
    <div class="content">
      <span class="title title--small">{{ name }}</span>
      <span class="description">{{ durationString }}</span>
    </div>
  </div>
</template>
{% endraw %}

<div class="layout layout--col layout--stretch layout--left">
  <div class="days flex flex--row flex--left flex--top gap"></div>
</div>

<div class="title_bar">
  <span class="title">Calendar</span>
</div>

<script>
  window.renderEvents(4, "full");
</script>
